# Copy this file to .env and fill in your own values. Never commit .env.
# Vite puts VITE_ variables into the public browser bundle, so they must never hold a true secret.

# Formspree form ID: the part after /f/ in your form's endpoint URL (https://formspree.io/f/<ID>)
VITE_FORMSPREE_ID=your_form_id_here
